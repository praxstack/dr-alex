<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  alexd health watchdog — DISABLED BY DEFAULT (gardener enable pattern, same as the check-in job).

  Every 5 minutes it runs `dr-alex health --notify`, which GETs http://127.0.0.1:8787/healthz
  and, only if the daemon is genuinely down, posts ONE macOS notification with a FIXED,
  non-interpolated body ("The Room isn't running right now."). No therapy data, ever — a lock
  screen is semi-public (council D5 rider).

  This does NOT change com.prax.dralex-alexd. KeepAlive + ThrottleInterval there are correct and
  stay exactly as they are: restarting forever self-heals every transient fault. This job only
  closes the DETECTION gap — it reads the DRALEX_BOOT_GRACE / DRALEX_WAKE_GRACE windows that the
  alexd plist has always exported and that, until now, nothing read.

  Never a false alarm at 3am: two consecutive failed probes are required, boot and wake grace
  windows suppress startup/sleep settling, any error computing a grace window fails toward
  SILENCE, and there is exactly one notification per outage with NO recovery notification.

  To ENABLE (one command — you, deliberately):
      cp tools/launchd/com.prax.dralex-health.plist ~/Library/LaunchAgents/ \
        && launchctl load -w ~/Library/LaunchAgents/com.prax.dralex-health.plist

  To DISABLE again:
      launchctl unload -w ~/Library/LaunchAgents/com.prax.dralex-health.plist
-->
<plist version="1.0">
<dict>
	<key>Disabled</key>
	<true/>

	<key>EnvironmentVariables</key>
	<dict>
		<key>DRALEX_BOOT_GRACE</key>
		<string>240</string>
		<key>DRALEX_WAKE_GRACE</key>
		<string>120</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/Users/prax/.local/bin:/usr/bin:/bin</string>
	</dict>

	<key>Label</key>
	<string>com.prax.dralex-health</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-lc</string>
		<string>/Users/prax/.local/bin/dr-alex health --notify</string>
	</array>

	<key>RunAtLoad</key>
	<false/>

	<key>StandardErrorPath</key>
	<string>/Users/prax/dr-alex/logs/dr-alex-health.err.log</string>

	<key>StandardOutPath</key>
	<string>/Users/prax/dr-alex/logs/dr-alex-health.out.log</string>

	<key>StartInterval</key>
	<integer>300</integer>

	<key>WorkingDirectory</key>
	<string>/Users/prax/dr-alex</string>
</dict>
</plist>
