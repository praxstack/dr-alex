<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Disabled</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DRALEX_BOOT_GRACE</key>
		<string>240</string>
		<key>DRALEX_WAKE_GRACE</key>
		<string>120</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/Users/prax/.local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>Crashed</key>
		<true/>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>com.prax.dralex-alexd</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-lc</string>
		<string>exec /Users/prax/.local/bin/dr-alex serve</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/prax/dr-alex/logs/dr-alex-alexd.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/prax/dr-alex/logs/dr-alex-alexd.out.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>/Users/prax/dr-alex</string>
</dict>
</plist>
