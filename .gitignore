# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# uv
.venv/

# OS
.DS_Store

# Dr. Alex — never commit conversation transcripts or any personal session data.
# (Phase 1 keeps transcripts in-memory only; this is belt-and-suspenders for later phases.)
*.transcript
transcripts/
state.db
state.db-*

# R1 (council 2026-07-17): clinical data never in git
data/continuity.md
records/
exports/
state.db*
*.wav
*.m4a
*.mp3
*.flac
tmp/

# Phase 4 (G19): durability backups (git bundles + encrypted state.db snapshots) — local only
data/backups/

# Phase 5 (alexd): device-pairing store (hashed tokens, never in the clear) + the pidfile.
# Auth data must never be tracked (Directive 3 / secrets discipline).
data/pairing.db
data/pairing.db-*
data/alexd.pid

# Phase 3: session-state JSON (last_session_at/last_topic + crash marker) — metadata, but
# derived + private; never tracked (Directive 3).
data/session_state.json
data/*.json
data/.session_state.*.tmp
data/.checkin.*.tmp
data/.health.*.tmp
data/.continuity.*.tmp

# Daemon logs. Body-free by contract (R3: structured facts only, content lives in POST bodies)
# but derived + local-only, and never tracked. They live HERE rather than /tmp because /tmp is
# wiped at every boot, which permanently destroyed the postmortem for an overnight failure.
# Size is bounded: the app log rotates (RotatingFileHandler) and the launchd-captured files are
# trimmed at daemon start. The dir itself is tracked (empty) so launchd always has somewhere to
# open its stdout/stderr — launchd does not create intermediate directories and silently
# discards output when it cannot open the path.
logs/*
!logs/.gitkeep

# Phase 2 (council D1): derived book index — rebuildable from the corpus, never committed
data/index/

# Phase 2b (drop-in books): the supplemental user manifest + PDF extraction caches are
# derived/private and live in the corpus dir (outside git by default). These patterns are
# belt-and-suspenders in case a corpus is ever pointed inside the repo (Directive 3).
user-books.json
*.extracted.txt
data/user-books.json
data/extracted/

# Session digests handed to the gardener — clinical content, never in git (Directive 3)
inbox/

# G22 (persona self-improvement loop): the keep-or-revert audit log + changelog are derived,
# local-only records of autonomous persona edits — never tracked (Directive 3 / R3). The
# accepted changes live in the git history as revertible commits; these logs are metadata.
data/improve/
